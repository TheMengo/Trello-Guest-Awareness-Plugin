{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Trello Guest Awareness",
  "version": "1.0.3",
  "description": "Understand Workspace guest access and notification signals before commenting on Trello.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.trello.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://trello.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Trello Guest Awareness — Settings"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
